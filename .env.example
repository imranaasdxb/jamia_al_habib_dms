# Copy these values into .env.local. Never put real credentials in this template.

# Pooled Neon PostgreSQL connection string for the application.
DATABASE_URL=""

# Direct (unpooled) connection string for schema migrations only.
DATABASE_URL_UNPOOLED=""

# Neon Auth URL from the Neon console, separate from the database URL.
NEON_AUTH_BASE_URL=""

# Secure random application cookie secret, at least 32 characters.
NEON_AUTH_COOKIE_SECRET=""

# Private Neon Object Storage bucket and branch-scoped storage:write credentials.
# These are server-only. Never prefix them with NEXT_PUBLIC_.
NEON_STORAGE_BUCKET="profile-photos"
AWS_ENDPOINT_URL_S3=""
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
